# Never commit .env files.

# --- Desktop app (apps/desktop/.env) -------------------------------------------------------
# Public values, baked into the installer at build time. The anon key is designed to be public:
# Row Level Security + the pl_* SQL functions decide what each signed-in user can do.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# TURN relay: needed when peers can't reach each other directly (symmetric NAT / CGNAT / 4G).
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- Developer only (repo root .env) -------------------------------------------------------
# Used ONLY by `npm run cloud:migrate` to create the tables/policies in your Supabase project.
# The app itself never reads it and it is never shipped to users.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
# Optional: Supabase CA certificate (Dashboard > Database > SSL) to verify TLS while migrating
DATABASE_SSL_CA=

# --- Local service overrides (optional) -----------------------------------------------------
# Signal server bind address (default 127.0.0.1; use 0.0.0.0 only to expose it on the LAN)
SIGNAL_HOST=127.0.0.1
# Moonlight / chiaki-ng, if not installed in the default location
MOONLIGHT_PATH=
CHIAKI_PATH=
